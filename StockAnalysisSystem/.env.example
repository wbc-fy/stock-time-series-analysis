# Tushare API Token
TUSHARE_TOKEN=

# Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stock_analysis
DB_USER=root
DB_PASSWORD=

# Logging
LOG_LEVEL=INFO

# Python collector
COLLECTOR_SOURCE=tushare
# mysql: database only; kafka: Kafka only; dual: both destinations
COLLECTOR_OUTPUT_MODE=mysql

# Kafka producer
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=stock-python-collector-v1
KAFKA_DAILY_TOPIC=stock.ods.daily.v1
KAFKA_BASIC_TOPIC=stock.ods.basic.v1
KAFKA_DLQ_TOPIC=stock.dead-letter.v1
KAFKA_ACKS=all
KAFKA_COMPRESSION_TYPE=lz4
KAFKA_RETRIES=5
KAFKA_LINGER_MS=5
KAFKA_MESSAGE_TIMEOUT_MS=30000

# Java consumer monitoring and protocol compatibility
KAFKA_CONSUMER_GROUP=stock-analysis-daily-v1
STOCK_DEAD_LETTER_TOPIC=stock.dead-letter.v1
STOCK_SUPPORTED_SCHEMA_VERSION=1
STOCK_MONITOR_ERROR_CAPACITY=100

# Flink V0.5 realtime indicator job (safe local/Docker defaults)
# Set this to the local JDK 21 directory when JAVA_HOME is not JDK 21.
FLINK_JAVA_HOME=
FLINK_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
FLINK_INPUT_TOPIC=stock.ods.daily.v1
FLINK_OUTPUT_TOPIC=stock.dws.daily-indicator.v1
FLINK_LATE_TOPIC=stock.late.daily.v1
FLINK_DLT_TOPIC=stock.flink.dead-letter.v1
FLINK_CONSUMER_GROUP=stock-flink-daily-indicator-v1
FLINK_CHECKPOINT_URI=file:///opt/flink/checkpoints
FLINK_CHECKPOINT_INTERVAL_MS=10000
FLINK_CHECKPOINT_TIMEOUT_MS=60000
FLINK_CHECKPOINT_MIN_PAUSE_MS=5000
FLINK_KAFKA_TRANSACTION_TIMEOUT_MS=600000
FLINK_PARALLELISM=3
FLINK_SCHEMA_VERSION=1
FLINK_DEPLOYMENT_NAMESPACE=stock-flink

# Market API V0.6: required password, never use empty credentials
CLICKHOUSE_HTTP_URL=http://127.0.0.1:8123
CLICKHOUSE_DB=stock_analytics
CLICKHOUSE_USER=stock_app
CLICKHOUSE_PASSWORD=
MARKET_KAFKA_GROUP=stock-clickhouse-indicators-v1
INDICATOR_TOPIC=stock.dws.daily-indicator.v1
MARKET_LISTENER_ENABLED=true
